{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": false,
  "functions": {
    "api/[...route].js": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": {
        "css/admin.css": "css/admin.css",
        "js/admin.js": "js/admin.js",
        "tienda.html": "tienda.html"
      }
    }
  },
  "redirects": [
    { "source": "/marca.html", "destination": "/tienda", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/academia.html", "destination": "/academia", "permanent": true },
    { "source": "/tienda.html", "destination": "/tienda", "permanent": true },
    { "source": "/berrys-lab.html", "destination": "/berrys-lab", "permanent": true },
    { "source": "/foro.html", "destination": "/foro", "permanent": true },
    { "source": "/glosario.html", "destination": "/glosario", "permanent": true },
    { "source": "/normas.html", "destination": "/normas", "permanent": true },
    { "source": "/envios.html", "destination": "/envios", "permanent": true },
    { "source": "/devoluciones.html", "destination": "/devoluciones", "permanent": true },
    { "source": "/privacidad.html", "destination": "/privacidad", "permanent": true },
    { "source": "/terminos.html", "destination": "/terminos", "permanent": true },
    { "source": "/academia/:slug.html", "destination": "/academia/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tienda", "destination": "/api/tienda" },
    { "source": "/foro", "destination": "/api/foro" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/feed.xml", "destination": "/api/feed" },
    { "source": "/academia", "destination": "/academia.html" },
    { "source": "/academia/:slug", "destination": "/academia/:slug.html" },
    { "source": "/berrys-lab", "destination": "/berrys-lab.html" },
    { "source": "/glosario", "destination": "/glosario.html" },
    { "source": "/normas", "destination": "/normas.html" },
    { "source": "/envios", "destination": "/envios.html" },
    { "source": "/devoluciones", "destination": "/devoluciones.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/guias/:id", "destination": "/api/guias/:id" },
    { "source": "/foro/hilo/:id", "destination": "/api/foro/hilo/:id" },
    { "source": "/perfil/:usuario", "destination": "/api/perfil/:usuario" },
    { "source": "/server/(.*)", "destination": "/__private_not_found" },
    { "source": "/scripts/(.*)", "destination": "/__private_not_found" },
    { "source": "/db/(.*)", "destination": "/__private_not_found" },
    { "source": "/tests/(.*)", "destination": "/__private_not_found" },
    { "source": "/css/admin.css", "destination": "/__private_not_found" },
    { "source": "/js/admin.js", "destination": "/__private_not_found" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://accounts.google.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://accounts.google.com https://challenges.cloudflare.com http://localhost:8000; frame-src https://accounts.google.com https://challenges.cloudflare.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/productos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/img/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
