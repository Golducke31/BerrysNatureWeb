# === Berrys Nature Web — .gitignore ===

# Proyecto NO relacionado: "Niko IA" tiene su propio repositorio (.git),
# por eso se excluye por completo de este repo.
Niko IA/

# Dependencias de Node (solo para la suite de pruebas)
node_modules/

# Variables de entorno: el .env real NUNCA se versiona (tiene DATABASE_URL,
# SESSION_SECRET, ADMIN_GATE_KEY, etc.). El template sí se versiona.
.env
.env.local
.env.*.local
.vercel/

# Internos de WorkBuddy (memoria, agentes, estado de sesión)
.workbuddy-ai/
.agents/

# Artefactos generados por los tests E2E
playwright-report/
test-results/
playwright/.cache/
# Salida alternativa de Playwright (workaround del guardián de borrado masivo)
.tmp-pw/

# Log de Chromium headless
debug.log

# Caches de Python / entornos virtuales
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Sistema / editores
.DS_Store
Thumbs.db
*.swp

# Capturas de pantalla sueltas (no forman parte del sitio)
Screenshot_*.jpg
1781126614010.png
