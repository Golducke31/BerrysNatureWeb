# ============================================================
# .env.example — copialo a .env y completá los valores.
# NUNCA subas el .env real al repositorio.
# En Vercel, estas variables se cargan en Settings → Environment Variables.
# ============================================================

# --- Base de datos (Neon) ---
# La inyecta automáticamente la integración de Neon en Vercel.
# Usá SIEMPRE el endpoint "pooled" (con -pooler en el host).
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/berrys?sslmode=require

# --- Acceso secreto del admin ---
# Slug secreto de la ruta del panel. 32+ bytes en hex. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SLUG=reemplazar_por_32_bytes_hex_aleatorios

# Segundo factor de ruta. Se exige como ?k=... en la URL del panel.
ADMIN_GATE_KEY=reemplazar_por_otra_clave_larga_aleatoria

# Clave para firmar/derivar (CSRF, hash de IP, cifrado del secreto TOTP).
# 32+ bytes aleatorios.
SESSION_SECRET=reemplazar_por_32_bytes_aleatorios

# IP allowlist del login de admin (separadas por coma).
# VACÍO = permitir todas (solo para desarrollo local).
# En producción: poné tu IP fija. Ej: 203.0.113.45,2001:db8::1
ADMIN_IP_ALLOWLIST=

# --- URL pública del sitio (para cookies y CORS del propio dominio) ---
APP_URL=http://localhost:3000

# --- Google Sign-In (opcional) ---
# Client ID de Google Cloud Console. Si queda vacío, el botón de Google
# avisa que falta configurarlo (el resto del sitio funciona igual).
GOOGLE_CLIENT_ID=

# --- Cloudflare Turnstile (antispam, opcional) ---
# Si queda vacío, el captcha se desactiva (útil en desarrollo).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Email transaccional (verificación de cuenta y recuperación de contraseña) ---
# Sin esto, el flujo de "olvidé mi contraseña" NO funciona en producción:
# el registro sigue andando, pero el email nunca sale.
#
#   MAIL_TRANSPORT=console   imprime el email en consola (desarrollo; default)
#   MAIL_TRANSPORT=resend    usa la API HTTP de Resend (requiere MAIL_API_KEY)
#   MAIL_TRANSPORT=webhook   POST JSON genérico a MAIL_ENDPOINT
#                            (sirve para Brevo, SES vía proxy o un servicio propio)
MAIL_TRANSPORT=console

# Remitente. Tiene que ser un dominio verificado en el proveedor.
MAIL_FROM=Berry's Nature <no-reply@berrysnature.com>

# Clave del proveedor (Resend o el webhook).
MAIL_API_KEY=

# URL del POST (solo si MAIL_TRANSPORT=webhook).
MAIL_ENDPOINT=

# --- Solo para los scripts locales (NO van a Vercel) ---
ADMIN_EMAIL=duenio@berrysnature.com
ADMIN_PASSWORD=
