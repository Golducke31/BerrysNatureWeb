# ============================================================
# .env.example — copialo a .env y completá los valores.
# NUNCA subas el .env real al repositorio.
# En Netlify, estas variables se cargan en Settings → Environment Variables.
# ============================================================

# --- Base de datos (Neon) ---
# Cargala en Netlify → Site configuration → Environment variables.
# Usá SIEMPRE el endpoint "pooled" (con -pooler en el host).
DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/berrys?sslmode=require

# --- Acceso secreto del admin ---
# Slug secreto de la ruta del panel. 32+ bytes en hex. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SLUG=reemplazar_por_32_bytes_hex_aleatorios

# Segundo factor de ruta. Se exige como ?k=... en la URL del panel.
ADMIN_GATE_KEY=reemplazar_por_otra_clave_larga_aleatoria

# Clave para firmar/derivar (CSRF, hash de IP, cifrado del secreto TOTP).
# 32+ bytes aleatorios.
SESSION_SECRET=reemplazar_por_32_bytes_aleatorios

# IP allowlist del login de admin (separadas por coma).
# VACÍO = permitir todas (solo para desarrollo local).
# En producción: poné tu IP fija. Ej: 203.0.113.45,2001:db8::1
ADMIN_IP_ALLOWLIST=

# --- URL pública del sitio (para cookies y CORS del propio dominio) ---
APP_URL=http://localhost:3000

# --- Google Sign-In (opcional) ---
# Client ID de Google Cloud Console. Si queda vacío, el botón de Google
# avisa que falta configurarlo (el resto del sitio funciona igual).
GOOGLE_CLIENT_ID=

# --- Cloudflare Turnstile (antispam, opcional) ---
# Si queda vacío, el captcha se desactiva (útil en desarrollo).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Email transaccional (verificación de cuenta y recuperación de contraseña) ---
# Sin esto, el flujo de "olvidé mi contraseña" NO funciona en producción:
# el registro sigue andando, pero el email nunca sale.
#
#   MAIL_TRANSPORT=console   imprime el email en consola (desarrollo; default)
#   MAIL_TRANSPORT=resend    usa la API HTTP de Resend (requiere MAIL_API_KEY)
#   MAIL_TRANSPORT=webhook   POST JSON genérico a MAIL_ENDPOINT
#                            (sirve para Brevo, SES vía proxy o un servicio propio)
MAIL_TRANSPORT=console

# Remitente. Tiene que ser un dominio verificado en el proveedor.
MAIL_FROM=Berry's Nature <no-reply@berrysnature.com.ar>

# Clave del proveedor (Resend o el webhook).
MAIL_API_KEY=

# URL del POST (solo si MAIL_TRANSPORT=webhook).
MAIL_ENDPOINT=

# --- MercadoPago (cobro del desbloqueo PRO) ---
# Sin estas variables, el botón de pago avisa que el cobro no está configurado
# y el resto del sitio funciona igual.
#
# Access token de tu aplicación en MercadoPago (Credenciales de producción).
MERCADOPAGO_ACCESS_TOKEN=

# Clave secreta de la firma de webhooks (Tus integraciones → Webhooks).
# Sin esto el webhook se RECHAZA a propósito: no se puede validar que la
# notificación venga de MercadoPago.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Berry's Lab (venta de la licencia anual) ---
# Precio de la licencia, en ARS. Es el que muestra la landing y el que se
# cobra: hay una sola fuente de verdad (GET /api/lab/info).
LAB_PRICE_ARS=175500

# Precio de la renovación anual. Si se deja vacío, usa LAB_PRICE_ARS.
LAB_RENEWAL_PRICE_ARS=175500

# Clave privada Ed25519 para firmar las licencias (PKCS8 en base64).
# Generarla con:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# La clave pública va embebida en el programa (core/licencia.py). Si se cambia
# esta clave hay que recompilar el .exe o las licencias nuevas no validan.
LAB_LICENSE_PRIVATE_KEY=

# --- Descarga del ZIP (bucket S3 compatible; R2 recomendado) ---
# Sin estas variables el flujo sigue vendiendo: el mail avisa que el envío
# es manual. Al completarlas, la descarga pasa a ser inmediata.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=berryslab
LAB_FILE_KEY=BerryLab/BerrysLab-1.1.0-win64.zip
# Horas de validez del link firmado (se regenera en cada descarga).
LAB_DOWNLOAD_TTL_HOURS=48
# Tamaño del ZIP en bytes, solo para mostrarlo en el botón.
LAB_FILE_BYTES=

# --- Solo para los scripts locales (NO van a Netlify) ---
ADMIN_EMAIL=duenio@berrysnature.com
ADMIN_PASSWORD=
